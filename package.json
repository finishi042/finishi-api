{
  "name": "finishi-api",
  "version": "1.0.0",
  "description": "Shared API server for Finishi admin and user applications",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "copy:templates": "cp -r src/admin/email/templates dist/admin/email/templates",
    "build": "tsc && npm run copy:templates",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "seed": "tsx scripts/seed.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:graph": "tsx scripts/seed-skill-graph.ts",
    "migrate": "tsx scripts/run-migrations.ts",
    "cleanup": "echo 'Run scripts/cleanup.sql in Supabase SQL Editor'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/env": "^5.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "11.1.0",
    "@supabase/supabase-js": "^2.45.4",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "handlebars": "^4.7.9",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "resend": "^6.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/handlebars": "^4.0.40",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
