<div class="email-body">
  <p class="greeting">{{#if name}}Hey {{name}}!{{else}}Hey there!{{/if}}</p>

  <p>{{message}}</p>

  {{#if skill}}
  <div class="feature-box">
    <p>
      We've matched you with content around <span class="badge">{{skill}}</span> to kickstart your learning journey on the right path.
    </p>
  </div>
  {{/if}}

  <p>
    Finishi delivers focused, bite-sized lessons built around your goals. No fluff, no overwhelm — just steady progress that sticks.
  </p>

  <div class="cta-wrap">
    <a class="cta" href="{{ctaUrl}}">Accept Invite</a>
  </div>

  <hr class="divider" />

  <p class="link-fallback">
    Button not working? Copy and paste this link into your browser:<br />
    <a href="{{ctaUrl}}">{{ctaUrl}}</a>
  </p>
</div>
