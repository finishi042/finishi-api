<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>{{subject}}</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
  <style>
    /* Reset */
    body, table, td, p, a, li { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }

    /* Base */
    body {
      margin: 0;
      padding: 0;
      width: 100% !important;
      min-width: 100%;
      background: linear-gradient(180deg, #F8F6FC 0%, #F3F4F6 100%);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      color: #1F2937;
      line-height: 1.6;
    }

    /* Container */
    .email-wrapper {
      width: 100%;
      max-width: 640px;
      margin: 0 auto;
      padding: 48px 24px;
    }

    .email-container {
      background: #FFFFFF;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 4px 24px rgba(123, 44, 191, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04);
    }

    /* Header */
    .email-header {
      background: linear-gradient(135deg, #7B2CBF 0%, #9D4EDD 50%, #C77DFF 100%);
      padding: 44px 40px;
      text-align: center;
      position: relative;
    }

    .email-header::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
      opacity: 0.4;
    }

    .logo-container {
      position: relative;
      z-index: 1;
    }

    .logo {
      width: 56px;
      height: 56px;
      background: rgba(255, 255, 255, 0.2);
      backdrop-filter: blur(8px);
      border-radius: 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
      border: 1px solid rgba(255, 255, 255, 0.25);
    }

    .logo-text {
      color: #FFFFFF;
      font-size: 24px;
      font-weight: 800;
      letter-spacing: -0.5px;
    }

    .header-title {
      margin: 0;
      color: #FFFFFF;
      font-size: 28px;
      font-weight: 700;
      letter-spacing: -0.5px;
      position: relative;
      z-index: 1;
    }

    .header-subtitle {
      margin: 8px 0 0;
      color: rgba(255, 255, 255, 0.85);
      font-size: 15px;
      font-weight: 500;
      position: relative;
      z-index: 1;
    }

    /* Body */
    .email-body {
      padding: 40px 44px;
    }

    .email-body p {
      margin: 0 0 18px;
      color: #374151;
      font-size: 16px;
      line-height: 1.7;
    }

    .email-body p:last-child {
      margin-bottom: 0;
    }

    .greeting {
      font-size: 17px;
      font-weight: 600;
      color: #1F2937;
    }

    /* CTA Button */
    .cta-wrap {
      text-align: center;
      margin: 32px 0;
    }

    .cta {
      display: inline-block;
      background: linear-gradient(135deg, #7B2CBF 0%, #9D4EDD 100%);
      color: #FFFFFF !important;
      text-decoration: none;
      padding: 16px 40px;
      border-radius: 12px;
      font-weight: 600;
      font-size: 16px;
      letter-spacing: 0.2px;
      box-shadow: 0 4px 14px rgba(123, 44, 191, 0.35);
      transition: all 0.2s ease;
    }

    .cta:hover {
      box-shadow: 0 6px 20px rgba(123, 44, 191, 0.45);
      transform: translateY(-1px);
    }

    /* Badge */
    .badge {
      display: inline-block;
      background: linear-gradient(135deg, #F6EEFF 0%, #EDE4F7 100%);
      color: #7B2CBF;
      padding: 6px 14px;
      border-radius: 24px;
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.1px;
    }

    /* Divider */
    .divider {
      border: none;
      height: 1px;
      background: linear-gradient(90deg, transparent 0%, #E5E7EB 50%, transparent 100%);
      margin: 28px 0;
    }

    /* Feature Box */
    .feature-box {
      background: linear-gradient(135deg, #FAFAFB 0%, #F3F4F6 100%);
      border-radius: 14px;
      padding: 20px 24px;
      margin: 24px 0;
      border: 1px solid #E5E7EB;
    }

    .feature-box p {
      margin: 0;
      font-size: 15px;
      color: #4B5563;
    }

    /* Link fallback */
    .link-fallback {
      font-size: 13px;
      color: #6B7280;
      word-break: break-all;
    }

    .link-fallback a {
      color: #7B2CBF;
      text-decoration: none;
    }

    /* Footer */
    .email-footer {
      background: #FAFAFB;
      padding: 28px 44px;
      text-align: center;
      border-top: 1px solid #F3F4F6;
    }

    .footer-links {
      margin: 0 0 16px;
    }

    .footer-links a {
      display: inline-block;
      color: #6B7280;
      text-decoration: none;
      font-size: 13px;
      font-weight: 500;
      margin: 0 12px;
    }

    .footer-links a:hover {
      color: #7B2CBF;
    }

    .footer-text {
      margin: 0;
      font-size: 12px;
      color: #9CA3AF;
      line-height: 1.7;
    }

    .footer-brand {
      color: #7B2CBF;
      font-weight: 600;
    }

    /* Responsive */
    @media only screen and (max-width: 600px) {
      .email-wrapper {
        padding: 24px 16px !important;
      }
      .email-header {
        padding: 36px 28px !important;
      }
      .email-body {
        padding: 32px 28px !important;
      }
      .email-footer {
        padding: 24px 28px !important;
      }
      .header-title {
        font-size: 24px !important;
      }
      .cta {
        padding: 14px 32px !important;
        font-size: 15px !important;
      }
    }
  </style>
</head>
<body>
  <div class="email-wrapper">
    <div class="email-container">
      <!-- Header -->
      <div class="email-header">
        <div class="logo-container">
          <div class="logo">
            <span class="logo-text">F</span>
          </div>
          <h1 class="header-title">Finishi</h1>
          <p class="header-subtitle">AI-powered micro-learning</p>
        </div>
      </div>

      <!-- Body Content -->
      {{{body}}}

      <!-- Footer -->
      <div class="email-footer">
        <div class="footer-links">
          <a href="https://finishi.com">Website</a>
          <a href="https://finishi.com/help">Help Center</a>
          <a href="https://finishi.com/privacy">Privacy</a>
        </div>
        <p class="footer-text">
          You received this email because you signed up for <span class="footer-brand">Finishi</span>.<br />
          &copy; {{year}} Finishi. All rights reserved.
        </p>
      </div>
    </div>
  </div>
</body>
</html>
