<div class="email-body">
  <p class="greeting">Hey there!</p>

  <p>
    You requested to reset your password. Use the verification code below to continue:
  </p>

  <!-- OTP Code Box -->
  <div style="text-align: center; margin: 36px 0;">
    <div style="display: inline-block; background: linear-gradient(135deg, #F6EEFF 0%, #EDE4F7 100%); border: 2px solid rgba(123, 44, 191, 0.15); border-radius: 16px; padding: 28px 48px;">
      <div style="font-size: 40px; font-weight: 700; letter-spacing: 12px; color: #7B2CBF; font-family: 'SF Mono', Monaco, 'Courier New', monospace;">{{otp}}</div>
    </div>
  </div>

  <div class="feature-box" style="text-align: center;">
    <p style="margin: 0; font-size: 14px; color: #6B7280;">
      This code expires in <strong style="color: #374151;">10 minutes</strong>
    </p>
  </div>

  <hr class="divider" />

  <p style="font-size: 14px; color: #6B7280;">
    Didn't request this? You can safely ignore this email. If you're concerned about your account security, please contact us at <a href="mailto:support@finishi.org" style="color: #7B2CBF; text-decoration: none; font-weight: 500;">support@finishi.org</a>
  </p>
</div>
